# Copy this file to .env.local (gitignored, never committed) to prefill
# convenience defaults for your own personal builds. Every variable here is
# optional; the app works with none of them set — users just paste their own
# key in Settings > AI assistant, same as always.
#
# VITE_OPENROUTER_DEFAULT_KEY prefills (but does not silently save) the
# OpenRouter key field in AI settings. It still requires hitting "Save
# connection" before it's stored in the native secure vault. If you build a
# signed app for other people to install, this key ships inside that build —
# do not set it for a build you intend to distribute publicly; leave it unset
# and let each person paste their own key instead.
VITE_OPENROUTER_DEFAULT_KEY=
